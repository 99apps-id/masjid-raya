# Salin berkas ini menjadi .env lalu isi nilainya.

# Kunci penandatangan sesi NextAuth. WAJIB diisi dan WAJIB acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sesi semua pengguna batal bila nilai ini diganti.
NEXTAUTH_SECRET=

# Alamat aplikasi. Wajib https di produksi agar cookie sesi dikirim terenkripsi.
NEXTAUTH_URL="http://localhost:3000"

# Lokasi database SQLite.
DATABASE_URL="file:./dev.db"

# Kata sandi akun awal yang dibuat `npm run db:seed`.
# Bila dibiarkan kosong, seed memakai sandi bawaan yang TIDAK aman untuk produksi.
SEED_ADMIN_PASSWORD=
SEED_PENGURUS_PASSWORD=

# Direktori penyimpanan berkas unggahan (foto, suara adzan).
# Bila dikosongkan, dipakai folder `uploads/` di akar proyek.
# Di produksi arahkan ke volume yang tidak terhapus saat deploy.
UPLOAD_DIR=
